{
  "schemaVersion": 2,
  "id": "neutral-conformance",
  "version": "0.2.0",
  "locale": "en",
  "routeRegistry": ["records", "conversation"],
  "intentRegistry": {
    "records": ["inspect", "complete"],
    "conversation": ["unsupported_execution"]
  },
  "capabilityGapEligibleRoutes": ["conversation"],
  "conversationWindow": 12,
  "models": {
    "router": {
      "provider": "test",
      "model": "structured-test",
      "temperature": 0.2
    },
    "tutor": {
      "provider": "test",
      "model": "tutor-test"
    }
  },
  "execution": {
    "freeformRouterThinkingLevel": "medium",
    "routes": {
      "records/inspect": { "mode": "model", "thinkingLevel": "medium", "toolIds": ["records.inspect"] },
      "records/complete": { "mode": "hybrid", "thinkingLevel": "high", "toolIds": ["records.complete"] },
      "conversation/unsupported_execution": { "mode": "model", "thinkingLevel": "medium", "toolIds": [] }
    }
  },
  "channels": ["test"],
  "memory": {
    "reviewEveryInboundTurns": 30,
    "reviewAtMilestones": true
  },
  "capabilityGaps": {
    "minimumConfidence": 0.75,
    "enabled": true
  },
  "feedback": {
    "enabled": false
  }
}
